      "summary": "Prepare the exact outgoing prompt and selected reference versions, without sending it.",
      "mutation": true,
      "revision": "source",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetKind",
          "targetID",
          "prompt"
        ],
        "properties": {
          "targetKind": {
            "enum": [
              "shot",
              "character"
            ]
          },
          "targetID": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "characterID",
                "versionID"
              ],
              "properties": {
                "characterID": {
                  "type": "string",
                  "minLength": 1
                },
                "versionID": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "images.export": {
