{
  "version": 1,
  "protocol": "One UTF-8 JSON request and response, each newline terminated, per Unix socket connection. Maximum request: 4 MiB.",
  "requestSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "version",
      "requestID",
      "operation",
      "parameters"
    ],
    "properties": {
      "version": {
        "const": 1
      },
      "requestID": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "operation": {
        "enum": [
          "status",
          "schema",
          "projects.list",
          "projects.create",
          "projects.import",
          "documents.list",
          "documents.open",
          "documents.import",
          "documents.create",
          "documents.inspect",
          "documents.save",
          "source.read",
          "edits.preview",
          "edits.apply",
          "edits.discard",
          "reviews.list",
          "reviews.archives",
          "reviews.navigate",
          "reviews.dismiss",
          "reviews.clear",
          "reviews.revert",
          "shots.list",
          "shots.add",
          "shots.update",
          "shots.remove",
          "shots.generate",
          "shots.apply",
          "characters.list",
          "characters.create",
          "characters.mark",
          "characters.update",
          "characters.extract",
          "images.prepare",
          "images.export",
          "images.submit",
          "images.import",
          "images.attach",
          "images.list",
          "images.agents",
          "images.select",
          "jobs.list",
          "jobs.status",
          "jobs.cancel",
          "jobs.retry"
        ]
      },
      "documentID": {
        "type": "string",
        "minLength": 1
      },
      "expectedRevision": {
        "type": "string",
        "minLength": 1
      },
      "parameters": {
        "type": "object"
      }
    }
  },
  "responseSchema": {
    "type": "object",
    "required": [
      "version",
      "requestID",
      "operation",
      "ok"
    ],
    "properties": {
      "version": {
        "const": 1
      },
      "requestID": {
        "type": [
          "string",
          "null"
        ]
      },
      "operation": {
        "type": [
          "string",
          "null"
        ]
      },
      "ok": {
        "type": "boolean"
      },
      "result": {},
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "operations": {
    "status": {
      "summary": "Inspect server health and managed project root.",
      "mutation": false,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    },
    "schema": {
      "summary": "Discover this versioned contract without opening Act.",
      "mutation": false,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    },
    "projects.list": {
      "summary": "List managed projects.",
      "mutation": false,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    },
    "projects.create": {
      "summary": "Create a project; refuse name collisions.",
      "mutation": true,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "projects.import": {
      "summary": "Copy a Fountain file and linked sidecars into a new project, preserving originals.",
      "mutation": true,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "documents.list": {
      "summary": "List live document IDs, source/planning revisions and persistence status.",
      "mutation": false,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    },
    "documents.open": {
      "summary": "Open a managed Fountain file without activation.",
      "mutation": true,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "documents.import": {
      "summary": "Copy a screenplay and linked sidecars into an existing project, then open the copy. Refuse collisions and preserve originals.",
      "mutation": true,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "path"
        ],
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "documents.create": {
      "summary": "Create a Fountain file in an existing project; refuse overwrite.",
      "mutation": true,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "documents.inspect": {
      "summary": "Inspect one live document and prepare linked metadata.",
      "mutation": false,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    },
    "documents.save": {
      "summary": "Save source through native conflict checks; optional path first-saves an untitled document to a new managed .fountain path.",
      "mutation": true,
      "revision": "source",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source.read": {
      "summary": "Read unsaved source and scene IDs; $document explicitly addresses the whole source.",
      "mutation": false,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "sceneID": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "edits.preview": {
      "summary": "Resolve an atomic batch against one revision; no source mutation.",
      "mutation": true,
      "revision": "source",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edits"
        ],
        "properties": {
          "edits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "sceneID"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "insert",
                    "replace",
                    "remove",
                    "move"
                  ]
                },
                "sceneID": {
                  "type": "string",
                  "minLength": 1
                },
                "match": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "side": {
                  "enum": [
                    "before",
                    "after"
                  ]
                },
                "destinationSceneID": {
                  "type": "string",
                  "minLength": 1
                },
                "destinationAnchor": {
                  "type": "string",
                  "minLength": 1
                },
                "destinationSide": {
                  "enum": [
                    "before",
                    "after"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "edits.apply": {
      "summary": "Apply a reviewed preview once, as one native undo step.",
      "mutation": true,
      "revision": "source",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "previewID"
        ],
        "properties": {
          "previewID": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "edits.discard": {
      "summary": "Discard an unused preview without altering source or review history.",
      "mutation": true,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "previewID"
        ],
        "properties": {
          "previewID": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reviews.list": {
      "summary": "Read persistent AI changes, conflict and dismissal state.",
      "mutation": false,
      "revision": "none",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      }
    },
    "reviews.archives": {
