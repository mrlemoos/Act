            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reviews.dismiss": {
      "summary": "Dismiss batch/all highlights without erasing history.",
      "mutation": true,
      "revision": "source",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "batchID": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reviews.clear": {
      "summary": "Explicitly clear review history; requires confirm:true.",
      "mutation": true,
      "revision": "source",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "confirm"
        ],
        "properties": {
          "confirm": {
            "const": true
          }
        }
      }
    },
    "reviews.revert": {
      "summary": "Safely revert a change/operation/batch; refuse overlap with later writing.",
      "mutation": true,
      "revision": "source",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "changeID"
        ],
        "properties": {
          "changeID": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
