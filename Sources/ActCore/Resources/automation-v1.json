      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shotID"
        ],
        "properties": {
          "shotID": {
            "type": "string",
            "minLength": 1
          },
          "framing": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "cameraMovement": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "shots.remove": {
      "summary": "Remove one shot; retain image history.",
